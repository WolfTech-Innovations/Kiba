name: SDDM Autologin User Sync

on:
  push:
    paths:
      - ".github/workflows/kiba.yml"
  pull_request:
    paths:
      - ".github/workflows/kiba.yml"

jobs:
  audit:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Checkout Code
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683

      - name: SDDM Autologin User Sync
        run: |
          U=$(grep "User=" .github/workflows/kiba.yml | cut -d= -f2); [ -n "$U" ] && ! grep -q "useradd.*$U" .github/workflows/kiba.yml && { echo "Error: user $U not created"; false; } || true
